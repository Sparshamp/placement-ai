# Copy this file to .env and adjust if needed. .env is gitignored.

# --- Postgres ---
POSTGRES_USER=adaptive_user
POSTGRES_PASSWORD=adaptive_pass
POSTGRES_DB=adaptive_aptitude
POSTGRES_PORT=5434
POSTGRES_HOST=localhost

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=question-images
# Set to true only for local dev -- exposes the bucket for public GET so the
# frontend can hit image URLs directly without going through the backend.
MINIO_PUBLIC_READ=true

# --- Adminer (Postgres web UI) ---
ADMINER_PORT=8081

# --- Paths to the cleaned dataset produced by the data-prep pipeline ---
QUESTIONS_CLEAN_JSON=C:\placement-ai\backend\app\features\adaptive_aptitude\data\questions_clean.json
QUESTIONS_WITH_IMAGE_JSON=C:\placement-ai\backend\app\features\adaptive_aptitude\data\questions_with_image.json
QUESTION_IMAGES_DIR=C:\placement-ai\backend\app\features\adaptive_aptitude\data\images

# --- Job recommendation ---
# Optional: Gemini for tailored resumes (Ollama is used as a fallback; otherwise
# the resume is reorganized without adding new facts).
GEMINI_API_KEY=
TAILORED_RESUME_MODEL=gemini-2.5-flash
# Optional cap when building the jobs Chroma index for the first time.
# Leave empty to ingest the full jobs CSV.
JOB_INGEST_MAX=200
# JOBS_CSV=
# JOBS_CHROMA_DIR=
